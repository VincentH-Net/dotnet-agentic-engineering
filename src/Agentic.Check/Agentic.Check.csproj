<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>agentic-check</ToolCommandName>
    <PackageId>Agentic.Check</PackageId>
    <Title>Agentic Check</Title>
    <Version>2.3.0</Version>
    <Authors>Vincent Hoogendoorn</Authors>
    <Company>InnoWvate.NET</Company>
    <Copyright>Copyright © 2026 Vincent Hoogendoorn / InnoWvate.NET</Copyright>
    <Description>Optimizes your repo for agentic engineering with .NET - based technologies.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/VincentH-Net/dotnet-agentic-engineering</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>agentic-check;agentic;dotnet-tool;dotnet;cli;skills;directives;github;repo;doctor;check;codex;claude-code;gh skills</PackageTags>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/VincentH-Net/dotnet-agentic-engineering</RepositoryUrl>
    <PackageReleaseNotes>https://github.com/VincentH-Net/dotnet-agentic-engineering/releases/tag/v$(Version)</PackageReleaseNotes>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Release builds map source paths to /_/ so published symbols never carry a local checkout path. -->
    <ContinuousIntegrationBuild Condition="'$(Configuration)' == 'Release'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.1" />
    <PackageReference Include="System.CommandLine" Version="2.0.9" />
  </ItemGroup>
  <ItemGroup><Compile Include="../Shared/ToolVersion.cs" Link="ToolVersion.cs" /></ItemGroup>
  <ItemGroup><Compile Include="../Shared/DnaLauncherContract.cs" Link="DnaLauncherContract.cs" /></ItemGroup>
</Project>
