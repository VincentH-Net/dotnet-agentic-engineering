<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dna</ToolCommandName>
    <PackageId>InnoWvate.Dna</PackageId>
    <Title>dna</Title>
    <Version>1.0.0</Version>
    <Authors>Vincent Hoogendoorn</Authors>
    <Company>InnoWvate.NET</Company>
    <Copyright>Copyright © 2026 Vincent Hoogendoorn / InnoWvate.NET</Copyright>
    <Description>Global shorthand command for the repo-local dotnet agentic tool and the latest Agentic.Check.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/VincentH-Net/dotnet-agentic-engineering</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>dna;agentic;dotnet-tool;dotnet;cli</PackageTags>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/VincentH-Net/dotnet-agentic-engineering</RepositoryUrl>
    <!-- Release builds map source paths to /_/ so published symbols never carry a local checkout path. -->
    <ContinuousIntegrationBuild Condition="'$(Configuration)' == 'Release'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <Compile Include="../Shared/ToolLauncher.cs" Link="ToolLauncher.cs" />
    <Compile Include="../Shared/DnaLauncherContract.cs" Link="DnaLauncherContract.cs" />
  </ItemGroup>
</Project>
