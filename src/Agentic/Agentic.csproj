<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>agentic</ToolCommandName>
    <PackageId>InnoWvate.Agentic</PackageId>
    <Title>Agentic</Title>
    <!-- Agentic.Check reads this literal version from this GitHub path to install a compatible tool.
         Keep it explicit here (no imports/expressions); update consumer -m values when major/minor changes.
         If this file moves, update Agentic.Check's source path; contract tests verify both. -->
    <Version>2.3.0</Version>
    <Authors>Vincent Hoogendoorn</Authors>
    <Company>InnoWvate.NET</Company>
    <Copyright>Copyright © 2026 Vincent Hoogendoorn / InnoWvate.NET</Copyright>
    <Description>Repo-local agentic tooling: prompt-log wrapping, history display, validation, and delegation to Agentic.Check.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/VincentH-Net/dotnet-agentic-engineering</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>agentic;dotnet-tool;dotnet;cli;prompt-log;git;agents</PackageTags>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/VincentH-Net/dotnet-agentic-engineering</RepositoryUrl>
    <PackageReleaseNotes>https://github.com/VincentH-Net/dotnet-agentic-engineering/releases/tag/v$(Version)</PackageReleaseNotes>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Release builds map source paths to /_/ so published symbols never carry a local checkout path. -->
    <ContinuousIntegrationBuild Condition="'$(Configuration)' == 'Release'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.9" />
  </ItemGroup>
  <ItemGroup><Compile Include="../Shared/ToolVersion.cs" Link="ToolVersion.cs" /></ItemGroup>
  <ItemGroup><Compile Include="../Shared/ToolLauncher.cs" Link="ToolLauncher.cs" /></ItemGroup>
  <ItemGroup><Compile Include="../Shared/DnaLauncherContract.cs" Link="DnaLauncherContract.cs" /></ItemGroup>
  <ItemGroup><Compile Include="../Shared/HelpText.cs" Link="HelpText.cs" /></ItemGroup>
</Project>
